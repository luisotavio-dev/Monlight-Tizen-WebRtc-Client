[Unit]
Description=Moonlight WebRTC Gateway
Documentation=https://github.com/luisotavio-dev/Monlight-Tizen-WebRtc-Client
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/moonlight-webrtc --source=moonlight --console --udp-ports=50000-50100
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=-%h/.local/share/moonlight-webrtc

[Install]
WantedBy=graphical-session.target
